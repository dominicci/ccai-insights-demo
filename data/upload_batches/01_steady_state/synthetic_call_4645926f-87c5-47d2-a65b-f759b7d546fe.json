      "user_id": 303,
      "start_timestamp_usec": 1765325125266666
    },
    {
      "text": "I need to return something.",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 96652,
      "start_timestamp_usec": 1765325129866666
    },
    {
      "text": "I can certainly look into that for you. May I have the order number, or the item you're looking to return?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 303,
      "start_timestamp_usec": 1765325131866666
