      "user_id": 60657,
      "start_timestamp_usec": 1765467364166666
    },
    {
      "text": "I can certainly look into that for you. May I have your name and order number?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 402,
      "start_timestamp_usec": 1765467366166666
    },
    {
