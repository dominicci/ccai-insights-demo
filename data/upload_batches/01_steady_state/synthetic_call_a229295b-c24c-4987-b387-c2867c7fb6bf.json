      "role": "CUSTOMER",
      "user_id": 79701,
      "start_timestamp_usec": 1765046998866666
    },
    {
      "text": "Thank you, Mark. I see the ProFit Jersey from that order. To make sure I understand, what specifically is the issue with the item? Is it a technical fault or a preference?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 304,
      "start_timestamp_usec": 1765047003599999
