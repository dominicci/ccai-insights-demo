    },
    {
      "text": "I need to return something.",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 78736,
      "start_timestamp_usec": 1764859593333332
    },
    {
      "text": "I can certainly look into that for you. Could I get your name and order number, please?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 401,
      "start_timestamp_usec": 1764859595333332
    },
    {
      "text": "Mark Peterson. Order 774-B-91.",
