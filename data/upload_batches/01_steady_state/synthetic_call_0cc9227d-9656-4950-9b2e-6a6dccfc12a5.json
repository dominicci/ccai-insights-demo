      "user_id": 78736,
      "start_timestamp_usec": 1764859601333332
    },
    {
      "text": "Thank you, Mark. I see your order for the Pro-Series Jersey. What specifically is the issue with the item?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 401,
      "start_timestamp_usec": 1764859603533332
    },
    {
