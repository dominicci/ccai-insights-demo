      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 98538,
      "start_timestamp_usec": 1765904248133333
    },
    {
      "text": "I can certainly look into that for you. Can I get your name and order number, please?",
      "speakerId": "AGENT",
