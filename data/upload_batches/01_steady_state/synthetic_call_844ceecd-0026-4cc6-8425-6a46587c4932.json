      "role": "CUSTOMER",
      "user_id": 98538,
      "start_timestamp_usec": 1765904255999999
    },
    {
      "text": "Thank you, Alex. I see the order here for the Aero Race Jersey. What specifically is the issue with the jersey?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 402,
      "start_timestamp_usec": 1765904257933332
