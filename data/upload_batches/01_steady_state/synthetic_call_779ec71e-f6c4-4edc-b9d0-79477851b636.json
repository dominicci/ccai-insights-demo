      "role": "CUSTOMER",
      "user_id": 90931,
      "start_timestamp_usec": 1766437345866666
    },
    {
      "text": "Thank you. Let me pull that up... I see the Urban Commuter Helmet, purchased on October 11th. Is that correct?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 304,
