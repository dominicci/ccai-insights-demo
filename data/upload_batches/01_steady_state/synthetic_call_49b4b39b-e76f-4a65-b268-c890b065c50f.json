      "role": "AGENT",
      "user_id": 301,
      "start_timestamp_usec": 1764613846866663
    },
    {
      "text": "Great. So what's next?",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 20268,
      "start_timestamp_usec": 1764613858733329
