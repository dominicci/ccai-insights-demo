      "role": "CUSTOMER",
      "user_id": 58476,
      "start_timestamp_usec": 1766841132199997
    },
    {
      "text": "I'm sorry to hear they're causing you discomfort. Let me just check the delivery date... Okay, I see you received them 66 days ago.",
      "speakerId": "AGENT",
