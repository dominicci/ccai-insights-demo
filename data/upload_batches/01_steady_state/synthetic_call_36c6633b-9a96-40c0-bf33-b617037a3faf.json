      "role": "AGENT",
      "user_id": 401,
      "start_timestamp_usec": 1765631964799998
    },
    {
      "text": "Fine. I suppose that works.",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 18931,
      "start_timestamp_usec": 1765631976933331
