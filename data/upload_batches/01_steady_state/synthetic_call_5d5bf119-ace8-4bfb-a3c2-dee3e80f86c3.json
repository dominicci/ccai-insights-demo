      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 57934,
      "start_timestamp_usec": 1766935583533333
    },
    {
      "text": "Okay, just give me one moment to pull that up for you... I see it here, an order for the Velo Carbon cycling shoes.",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 302,
      "start_timestamp_usec": 1766935587733333
    },
    {
