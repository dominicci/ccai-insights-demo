      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 57934,
      "start_timestamp_usec": 1766935595599999
    },
    {
      "text": "I can certainly check on that for you. Let's see... the delivery date was about 75 days ago.",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 302,
      "start_timestamp_usec": 1766935605666665
