      "user_id": 23415,
      "start_timestamp_usec": 1764808899133332
    },
    {
      "text": "Thank you, Sam. One moment... I see the order for the Aero Road Helmet. To get started, could you tell me what the issue is? Is it a technical fault or more of a preference?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 304,
      "start_timestamp_usec": 1764808902533332
