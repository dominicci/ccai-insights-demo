      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 304,
      "start_timestamp_usec": 1768165532333331
    },
    {
      "text": "Right. So, yes or no, can I return it?",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 72498,
      "start_timestamp_usec": 1768165543933331
    },
    {
