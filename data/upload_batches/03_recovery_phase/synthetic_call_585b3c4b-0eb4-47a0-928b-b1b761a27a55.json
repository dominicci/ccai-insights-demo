      "role": "AGENT",
      "user_id": 304,
      "start_timestamp_usec": 1768165546666664
    },
    {
      "text": "Okay, finally. That's all I needed. Thank you.",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 72498,
      "start_timestamp_usec": 1768165558199997
