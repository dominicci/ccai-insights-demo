      "role": "CUSTOMER",
      "user_id": 79678,
      "start_timestamp_usec": 1769009269466666
    },
    {
      "text": "Thank you. One moment... Okay, I see the order for the Pro-Tread cycling shoes. To get started, could you tell me what specifically is the issue with them?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 401,
      "start_timestamp_usec": 1769009271066666
    },
    {
