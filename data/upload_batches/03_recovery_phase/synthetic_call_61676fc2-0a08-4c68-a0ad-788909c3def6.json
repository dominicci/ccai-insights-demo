    {
      "text": "I need to return something.",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 79678,
      "start_timestamp_usec": 1769009262200000
    },
    {
      "text": "I can certainly look into that for you. Do you have your order number handy?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 401,
      "start_timestamp_usec": 1769009264200000
