    {
      "text": "My VeloBand Pulse is broken.",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 17460,
      "start_timestamp_usec": 1768001097799999
    },
    {
      "text": "I'm certainly sorry to hear you're having trouble with it. To make sure I understand, is it a technical fault or more of a preference issue with the device?",
