      "role": "CUSTOMER",
      "user_id": 17460,
      "start_timestamp_usec": 1768001110466665
    },
    {
      "text": "I see. Could you tell me a little more about what's happening? What makes you say it's broken?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 302,
      "start_timestamp_usec": 1768001112733331
