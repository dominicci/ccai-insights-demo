      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 37504,
      "start_timestamp_usec": 1769367299966662
    },
    {
      "text": "I appreciate you holding. I have approved the return and just emailed a pre-paid shipping label to the address on file. You can just print that, attach it to the package, and drop it off at any post office.",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 303,
      "start_timestamp_usec": 1769367302833328
    },
    {
      "text": "Whatever. I'll get to it.",
