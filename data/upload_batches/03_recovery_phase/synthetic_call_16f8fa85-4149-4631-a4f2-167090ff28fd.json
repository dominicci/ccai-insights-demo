  "entries": [
    {
      "text": "Thank you for calling VeloFit. Your call may be recorded for quality assurance. Please hold for the next available agent.",
      "speakerId": "AUTOMATED_AGENT",
      "role": "AUTOMATED_AGENT",
      "user_id": 0,
      "start_timestamp_usec": 1769367233000000
    },
    {
      "text": "Thank you for holding. My name is Sarah. How can I help you today?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 303,
      "start_timestamp_usec": 1769367241266666
    },
    {
      "text": "I need to return something.",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 37504,
      "start_timestamp_usec": 1769367245866666
    },
    {
      "text": "I can certainly look into that for you. Can I get your name and order number, please?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 303,
      "start_timestamp_usec": 1769367247866666
    },
    {
      "text": "Alex Chen. Order 788-4B-901.",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 37504,
      "start_timestamp_usec": 1769367253733332
    },
    {
      "text": "Thank you, Alex. I see the order here for the Pro-Frame helmet. Can I ask, what specifically is the issue? Is it a technical fault or a preference?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 303,
      "start_timestamp_usec": 1769367255799998
    },
    {
      "text": "The color is wrong. It's not what I expected.",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 37504,
      "start_timestamp_usec": 1769367265799998
    },
    {
      "text": "I understand. And is the item still in new condition?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 303,
      "start_timestamp_usec": 1769367268999998
    },
    {
      "text": "Yes. The box is unopened.",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 37504,
      "start_timestamp_usec": 1769367272733331
    },
    {
      "text": "Okay, thank you for confirming. Let me just check the purchase date... I see it was delivered 61 days ago. One moment.",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 303,
      "start_timestamp_usec": 1769367274599997
    },
    {
      "text": "Fine.",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 37504,
      "start_timestamp_usec": 1769367282666663
    },
    {
      "text": "Alright, Alex. Thank you for your patience. I've confirmed that for a standard item like this helmet, you are well within our 90-day return window. Getting the right gear for your safety is our top priority, so I am happy to process this for you.",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 303,
      "start_timestamp_usec": 1769367283366663
    },
    {
