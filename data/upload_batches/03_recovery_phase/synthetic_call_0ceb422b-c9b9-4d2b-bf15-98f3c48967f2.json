      "role": "CUSTOMER",
      "user_id": 70619,
      "start_timestamp_usec": 1768748261166665
    },
    {
      "text": "Okay, I can certainly help you with that. Can I get your order number please?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 206,
      "start_timestamp_usec": 1768748266166665
