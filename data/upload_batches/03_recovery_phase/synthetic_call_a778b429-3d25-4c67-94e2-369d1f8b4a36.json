      "user_id": 92471,
      "start_timestamp_usec": 1768917834133333
    },
    {
      "text": "Thank you, Mark. I see your order for the Urban Commuter Helmet. To proceed, could you tell me what specifically is the issue? Is it a technical fault or more of a preference?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 401,
      "start_timestamp_usec": 1768917836999999
