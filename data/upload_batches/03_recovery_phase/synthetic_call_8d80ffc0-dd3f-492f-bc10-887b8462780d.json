      "user_id": 94795,
      "start_timestamp_usec": 1768743447799999
    },
    {
      "text": "Okay, I see. Is it a technical fault with the material, or is it a preference issue with the fit?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 302,
      "start_timestamp_usec": 1768743450333332
