      "role": "AGENT",
      "user_id": 205,
      "start_timestamp_usec": 1769031939466663
    },
    {
      "text": "Perfect. So I just print that and stick it on the box?",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 84852,
      "start_timestamp_usec": 1769031950466663
