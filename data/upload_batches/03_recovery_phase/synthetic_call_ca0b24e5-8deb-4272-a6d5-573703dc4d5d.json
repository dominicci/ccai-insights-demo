      "role": "CUSTOMER",
      "user_id": 10995,
      "start_timestamp_usec": 1768576954933333
    },
    {
      "text": "Okay, I can certainly look into that for you. Do you have your order number handy?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 402,
      "start_timestamp_usec": 1768576956999999
