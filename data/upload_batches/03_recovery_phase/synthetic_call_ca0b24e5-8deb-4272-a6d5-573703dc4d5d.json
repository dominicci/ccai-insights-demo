      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 10995,
      "start_timestamp_usec": 1768576962666665
    },
    {
      "text": "Got it. Pulling that up now... Okay, I see the order. Before we proceed, can you tell me what specifically is the issue with them? Is it a technical fault or more of a preference?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 402,
      "start_timestamp_usec": 1768576965666665
