      "user_id": 36946,
      "start_timestamp_usec": 1768568761533333
    },
    {
      "text": "Thank you. Let me pull that up... I see an order for the Aero-Dynamic Helmet placed 67 days ago. Is that the correct item?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 401,
      "start_timestamp_usec": 1768568762933333
