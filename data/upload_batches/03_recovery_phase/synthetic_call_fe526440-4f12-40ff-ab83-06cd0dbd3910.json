    },
    {
      "text": "Thank you for holding. My name is David, and you've reached VeloFit customer support. How can I help you today?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 304,
      "start_timestamp_usec": 1768840107200000
    },
    {
      "text": "I need to return something.",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 75459,
      "start_timestamp_usec": 1768840114800000
    },
    {
      "text": "I can certainly look into that for you. Could I get your name and order number, please?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 304,
      "start_timestamp_usec": 1768840116800000
