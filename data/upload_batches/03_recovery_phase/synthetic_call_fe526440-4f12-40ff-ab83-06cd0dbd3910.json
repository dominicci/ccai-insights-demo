      "user_id": 75459,
      "start_timestamp_usec": 1768840122800000
    },
    {
      "text": "Thank you, Sarah. I see your order for the ProForm cycling shoes, delivered on December 28th. To get started, could you tell me what specifically is the issue with them?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 304,
      "start_timestamp_usec": 1768840125466666
    },
    {
