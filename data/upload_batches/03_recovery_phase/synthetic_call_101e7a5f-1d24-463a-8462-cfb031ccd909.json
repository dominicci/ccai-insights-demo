      "user_id": 401,
      "start_timestamp_usec": 1768082046866663
    },
    {
      "text": "Oh. Fine. So you're just taking it back then?",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 93325,
      "start_timestamp_usec": 1768082057333329
    },
    {
