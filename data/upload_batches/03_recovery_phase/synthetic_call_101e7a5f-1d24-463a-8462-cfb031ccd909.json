      "role": "CUSTOMER",
      "user_id": 93325,
      "start_timestamp_usec": 1768082007333332
    },
    {
      "text": "I'm sorry to hear that. To look into this for you, could I please get your name and order number?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 401,
      "start_timestamp_usec": 1768082009333332
