      "role": "CUSTOMER",
      "user_id": 73560,
      "start_timestamp_usec": 1769002452999998
    },
    {
      "text": "I see. Well, you are well within the return window, so that's **no problem** at all.",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 203,
      "start_timestamp_usec": 1769002458866664
    },
