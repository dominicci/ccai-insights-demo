      "role": "CUSTOMER",
      "user_id": 26144,
      "start_timestamp_usec": 1769109052799997
    },
    {
      "text": "I've just initiated the return in our system. I'm sending a pre-paid **return label** to the email on file right now. You should see it in the next few minutes. Just print that out and attach it to the package.",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 203,
      "start_timestamp_usec": 1769109056266663
