      "user_id": 204,
      "start_timestamp_usec": 1769018275466664
    },
    {
      "text": "Oh, great! That's a relief. What do I need to do?",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 30141,
      "start_timestamp_usec": 1769018283599997
    },
    {
