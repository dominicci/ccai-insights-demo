      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 204,
      "start_timestamp_usec": 1769018287066663
    },
    {
      "text": "Yes, that's the one. So I just print it out?",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 30141,
      "start_timestamp_usec": 1769018296666663
    },
    {
