      "role": "AGENT",
      "user_id": 202,
      "start_timestamp_usec": 1768061963466665
    },
    {
      "text": "Wow, a credit too? That's really generous. Thank you so much, Linda!",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 16536,
      "start_timestamp_usec": 1768061981266665
    },
    {
