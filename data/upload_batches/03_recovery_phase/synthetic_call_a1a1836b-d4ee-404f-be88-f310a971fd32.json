      "role": "CUSTOMER",
      "user_id": 51035,
      "start_timestamp_usec": 1767878129799998
    },
    {
      "text": "Thank you, Mark. I'm pulling that up now... I see the Trail Helmet. Are you looking to return that item?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 303,
      "start_timestamp_usec": 1767878132066664
