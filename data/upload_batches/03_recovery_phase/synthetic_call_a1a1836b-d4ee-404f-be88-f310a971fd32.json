      "user_id": 51035,
      "start_timestamp_usec": 1767878122333332
    },
    {
      "text": "I can certainly help with that. Could I get your name and order number, please?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 303,
      "start_timestamp_usec": 1767878124333332
