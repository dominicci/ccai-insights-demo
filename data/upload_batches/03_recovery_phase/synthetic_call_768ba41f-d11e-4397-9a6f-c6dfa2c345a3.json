    },
    {
      "text": "Thank you for holding. My name is David. How can I help you today?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 304,
      "start_timestamp_usec": 1768428818533333
    },
    {
      "text": "I need to return something.",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 90905,
      "start_timestamp_usec": 1768428823133333
    },
    {
      "text": "I can certainly look into that for you. Can you tell me which item you're looking to return?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 304,
      "start_timestamp_usec": 1768428825133333
