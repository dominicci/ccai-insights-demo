    {
      "text": "Yeah, hi. I need to start a return for a VeloBand GPS Tracker.",
      "speakerId": "CUSTOMER",
      "role": "CUSTOMER",
      "user_id": 30546,
      "start_timestamp_usec": 1769215045999999
    },
    {
