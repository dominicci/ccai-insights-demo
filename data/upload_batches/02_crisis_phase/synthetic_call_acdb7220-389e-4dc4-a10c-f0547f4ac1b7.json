      "user_id": 30808,
      "start_timestamp_usec": 1767544264799999
    },
    {
      "text": "Thank you. One moment... Okay, I see the order for the Velo-Pro cycling shoes. Is that the item?",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 302,
