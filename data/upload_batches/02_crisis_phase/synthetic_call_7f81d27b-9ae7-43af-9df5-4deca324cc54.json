      "role": "CUSTOMER",
      "user_id": 55461,
      "start_timestamp_usec": 1767727797599999
    },
    {
      "text": "Got it, VF549821. One moment while I pull that up... Okay, I see the order. It looks like it was delivered about 58 days ago.",
      "speakerId": "AGENT",
      "role": "AGENT",
      "user_id": 205,
